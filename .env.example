# Server-only path to the persistent DuckDB file. Leave empty to use data/lead-intelligence.duckdb.
MONSTRO_LEAD_DB=
# PostgreSQL stores authentication and mutable commercial records.
DATABASE_URL=
# Local gratuito quando DATABASE_URL estiver vazio.
MONSTRO_AUTH_DB=data/local-auth.sqlite
# Defina como false em Windows sem privilégio para criar symlinks no build local.
MONSTRO_STANDALONE=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=5
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://monstro.example.com
